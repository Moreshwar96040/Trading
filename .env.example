# Copy to .env and adjust. Every service reads from here — no values are hardcoded.

# ---------- PostgreSQL (docker-compose) ----------
POSTGRES_DB=trading
POSTGRES_USER=trading
POSTGRES_PASSWORD=trading
POSTGRES_PORT=5432

# ---------- Spring Boot backend ----------
DB_URL=jdbc:postgresql://localhost:5432/trading
DB_USER=trading
DB_PASSWORD=trading
SERVER_PORT=8080
MARKET_DATA_SERVICE_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:4200
CANDLES_DEFAULT_RANGE_DAYS=365
CANDLES_MAX_RANGE_DAYS=3700
LOG_LEVEL=INFO

# ---------- Python market-data service ----------
DATABASE_URL=postgresql+psycopg2://trading:trading@localhost:5432/trading
CSV_DATASET_DIR=../nse_dataset
YAHOO_THROTTLE_SECONDS=1.0
YAHOO_MAX_RETRIES=3
SYNC_DEFAULT_LOOKBACK_DAYS=730
SCHEDULER_ENABLED=true
SYNC_CRON=30 18 * * 1-5
FUNDAMENTALS_CRON=0 8 * * 6
TIMEZONE=Asia/Kolkata

# ---------- AI insights (news digest + fundamentals explanations) ----------
# Get a key at https://console.anthropic.com — leave empty to disable LLM insights
# (news headlines and raw fundamentals still work without it).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
ANTHROPIC_MAX_TOKENS=1000
NEWS_MAX_ARTICLES=12
# Market-wide RSS feeds ("Name|url" comma-separated). Defaults cover WSJ (official
# Dow Jones feed), FT markets, Google News India business (syndicated Reuters/
# Bloomberg coverage), Economic Times and Mint — override to add/remove sources.
# MARKET_NEWS_FEEDS=WSJ|https://feeds.content.dowjones.io/public/rss/RSSMarketsMain,FT|https://www.ft.com/markets?format=rss
# Per-STOCK news feeds ("Name|url-template" comma-separated). yfinance's news API
# covers only a fraction of NSE tickers, so these keyless sources are fanned out
# and merged per symbol. Placeholders: {query} = URL-encoded '"Company" OR "TICKER"',
# {symbol} = Yahoo symbol (e.g. INFY.NS). Headlines are relevance-filtered against
# the company name before storage, so adding a broad source is safe.
# STOCK_NEWS_FEEDS=GoogleNews|https://news.google.com/rss/search?q={query}+when:21d&hl=en-IN&gl=IN&ceid=IN:en,BingNews|https://www.bing.com/news/search?q={query}&format=RSS,YahooRSS|https://feeds.finance.yahoo.com/rss/2.0/headline?s={symbol}&region=IN&lang=en-IN
STOCK_NEWS_MAX_AGE_DAYS=21
# $/million tokens — used for the in-app cost tracker (match your model's price card)
ANTHROPIC_PRICE_INPUT_PER_MTOK=1.0
ANTHROPIC_PRICE_OUTPUT_PER_MTOK=5.0
USD_TO_INR=84.0

# ---------- Paper autopilot (Alpha Stack trades its own signals) ----------
# PAPER ONLY — there is no live code path. When true, the daily job opens paper
# positions for setups scoring >= 55 (max 8 open), attaches an ATR stop/target,
# and records the conviction behind each entry so realised P&L can be attributed
# back to the score. Leave false until you want that experiment running.
AUTOPILOT_ENABLED=false
# The autopilot places orders through the Spring paper API (Spring stays the
# only writer of the paper book).
# BACKEND_BASE_URL=http://localhost:8080

# ---------- Exness / MetaTrader 5 (FX & crypto, READ-ONLY) ----------
# Exness publishes no retail REST API, so the app attaches to a MetaTrader 5
# terminal running on this machine (Windows only):
#   1. pip install MetaTrader5      (in the market-data-service venv)
#   2. open MT5, log into your Exness account, leave it running
# Leave these blank to use whichever account the terminal is already logged into
# — the normal case. Set them only to pin a specific account.
# MT5_LOGIN=12345678
# MT5_PASSWORD=
# MT5_SERVER=Exness-MT5Real
# Optional explicit path if you run several terminals:
# MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# ---------- API security ----------
# OPTIONAL locally, REQUIRED before tunneling (ngrok): gates every /api endpoint
# behind an X-Api-Key header (webhooks keep their own token). After setting it,
# run once in the browser console: localStorage.setItem('api_key', '<same value>')
API_KEY=

# ---------- Upstox (READ-ONLY live portfolio import) ----------
# Create an app at https://account.upstox.com/developer/apps with redirect URI
# http://localhost:8080/api/v1/upstox/callback — tokens expire daily ~03:30 IST.
# This integration cannot place orders by design.
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:8080/api/v1/upstox/callback

# ---------- TradingView webhook bridge ----------
# Set a long random string to enable POST /api/v1/webhooks/tradingview.
# TradingView alerts with this token in their JSON execute paper trades here.
# Leave empty to keep the bridge disabled.
TRADINGVIEW_WEBHOOK_SECRET=
